<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>UwUTerm</AssemblyName>
    <RootNamespace>UwUTerm</RootNamespace>
    <Version>0.1.0</Version>
    <!-- BepInEx plugins are loaded by reflection; nothing here is publicly consumed. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <!-- Where the game lives. In order of precedence:
         1. dotnet build -p:GreyHackDir=...
         2. a GREYHACK_DIR environment variable
         3. Local.props next to this file (gitignored) containing
            <Project><PropertyGroup><GreyHackDir>...</GreyHackDir></PropertyGroup></Project>
         4. the default Steam location for the platform -->
  <Import Project="Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />

  <PropertyGroup>
    <GreyHackDir Condition="'$(GreyHackDir)' == '' And '$(GREYHACK_DIR)' != ''">$(GREYHACK_DIR)</GreyHackDir>
    <GreyHackDir Condition="'$(GreyHackDir)' == '' And '$(OS)' == 'Windows_NT'">$(ProgramFiles) (x86)\Steam\steamapps\common\Grey Hack</GreyHackDir>
    <GreyHackDir Condition="'$(GreyHackDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Grey Hack</GreyHackDir>
    <GameManaged>$(GreyHackDir)/Grey Hack_Data/Managed</GameManaged>
    <BepInExCore>$(GreyHackDir)/BepInEx/core</BepInExCore>
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the SDK build net472 on Linux without Mono installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManaged)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp" Publicize="true">
      <HintPath>$(GameManaged)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OSA">
      <HintPath>$(GameManaged)/OSA.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManaged)/Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManaged)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManaged)/UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManaged)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManaged)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckGameDir" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(GameManaged)')"
           Text="Grey Hack not found at &quot;$(GreyHackDir)&quot;. Set GREYHACK_DIR, pass -p:GreyHackDir=..., or create Local.props - see README." />
    <Error Condition="!Exists('$(BepInExCore)/BepInEx.dll')"
           Text="BepInEx is not installed in &quot;$(GreyHackDir)&quot;. Install BepInEx 5 into the game folder first." />
  </Target>

  <Target Name="DeployPlugin" AfterTargets="Build"
          Condition="'$(DeployToGame)' == 'true' And Exists('$(GreyHackDir)/BepInEx/plugins')">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(AssemblyName).pdb"
          DestinationFolder="$(GreyHackDir)/BepInEx/plugins"
          SkipUnchangedFiles="false" ContinueOnError="true" />
    <Message Importance="high" Text="Deployed $(AssemblyName).dll -> $(GreyHackDir)/BepInEx/plugins" />
  </Target>

</Project>
